{
  "bar": {
    "background": "none",
    "layout": {
      "center": [
        {
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "1Password_status_icon_1",
            "Slack_status_icon_1"
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/lazyvpn-status",
          "id": "lazyvpn",
          "interval": 5,
          "keepSpace": true,
          "onClick": "~/.config/omarchy/bar/scripts/lazyvpn-toggle",
          "onRightClick": "omarchy-launch-or-focus-tui lazyvpn",
          "type": "command"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "michael.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
