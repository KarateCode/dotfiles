{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "1Password_status_icon_1",
            "Slack_status_icon_1"
          ]
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "lazyvpn",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/lazyvpn-status",
          "interval": 5,
          "onClick": "~/.config/omarchy/bar/scripts/lazyvpn-toggle",
          "onRightClick": "omarchy-launch-or-focus-tui lazyvpn",
          "keepSpace": true
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": []
}
