#!/usr/bin/env bash
# Connect / disconnect lazyvpn from the Omarchy bar.
#
# Uses only lazyvpn's supported CLI surface:
#   connect    -> `lazyvpn random`      (picks among configured servers)
#   disconnect -> `lazyvpn daemon stop`
#
# `lazyvpn daemon run <server>` is marked "Internal command" in upstream's
# main.go and runs in the foreground, so it is deliberately not used here.
#
# NOTE: `random` is exact while there is a single server configured. If more
# servers are added later and a specific one should always be used, switch
# CONNECT_CMD to `quickest` (lowest latency) instead.

set -uo pipefail

LAZYVPN="$HOME/.local/bin/lazyvpn"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/lazyvpn-toggle.lock"

notify() { notify-send -a "VPN" -t 4000 "$@" >/dev/null 2>&1 || true; }

[[ -x "$LAZYVPN" ]] || { notify "VPN" "lazyvpn not found"; exit 1; }

# Serialize: connecting takes ~15s, and double-clicking the bar icon
# mid-connect would otherwise race two daemons against one interface.
exec 9>"$LOCK"
if ! flock -n 9; then
  notify "VPN" "Busy — an operation is already running"
  exit 0
fi

state="$("$LAZYVPN" waybar 2>/dev/null | jq -r '.alt // ""')"

case "$state" in
  connected|connecting)
    notify "VPN" "Disconnecting…"
    if out="$("$LAZYVPN" daemon stop 2>&1)"; then
      notify "VPN" "Disconnected"
    else
      notify "VPN" "Disconnect failed: ${out:-unknown error}"
    fi
    ;;
  *)
    notify "VPN" "Connecting…"
    if out="$("$LAZYVPN" random 2>&1)"; then
      ip="$("$LAZYVPN" waybar 2>/dev/null | jq -r '.tooltip // ""' | tail -n1)"
      notify "VPN" "Connected${ip:+ — $ip}"
    else
      notify "VPN" "Connect failed: $(tail -n1 <<<"$out")"
    fi
    ;;
esac
