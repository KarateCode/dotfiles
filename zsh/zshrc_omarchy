# zshrc for the Omarchy (Linux) box. The macOS files live beside this one as
# zshrc_mac / zprofile_mac / zlogin_mac and are NOT shared -- they reference
# /opt/homebrew, gls, and /Users/michaelschneider paths.
#
# Symlinked into place with:
#   ln -s ~/dotfiles/zsh/zshrc_omarchy ~/.zshrc
#
# The login shell is bash ON PURPOSE -- do NOT `chsh -s /usr/bin/zsh`.
# Omarchy expects bash as the login shell: it bootstraps OMARCHY_PATH and PATH
# from /usr/share/omarchy/default/bash/env-bootstrap and loads its own rc.
# ~/.bashrc runs all of that and then hands off with `exec zsh` on its last
# line, so zsh inherits a fully prepared environment.
#
# What survives that handoff and what doesn't:
#   INHERITED  exported vars -- OMARCHY_PATH, PATH, the exports in
#              ~/dotfiles/.sensitive.sh (all 2 of them are exports)
#   LOST       aliases and shell functions, which are shell state rather than
#              environment. That is why Omarchy's alias/function files are
#              re-sourced below; without them bash had 100 aliases and zsh
#              only 77.

# Lines configured by zsh-newuser-install
bindkey -e
# End of lines configured by zsh-newuser-install

# --- History -------------------------------------------------------------
# zsh-newuser-install did not write any history config, and zsh's defaults are
# useless for this: HISTFILE is unset, HISTSIZE=30, and SAVEHIST=0 -- meaning
# NOTHING is ever written to disk. Every new shell therefore started with an
# empty history, so zsh-autosuggestions could only suggest commands typed in
# that same window. Verify the live values any time with:
#     zsh -i -c 'echo "$HISTFILE $HISTSIZE $SAVEHIST"'
HISTFILE=~/.zsh_history
HISTSIZE=100000            # entries held in memory for this session
SAVEHIST=100000            # entries written to $HISTFILE (0 = save nothing)

setopt EXTENDED_HISTORY    # store timestamp + duration per entry
setopt INC_APPEND_HISTORY  # append each command as it runs, not at shell exit
setopt HIST_IGNORE_DUPS    # skip a command identical to the one before it
setopt HIST_IGNORE_SPACE   # a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS  # tidy up redundant whitespace
setopt HIST_VERIFY         # !! and friends expand for review, not instant run

# INC_APPEND_HISTORY means a NEW terminal loads everything previous terminals
# have run. It deliberately does not push new commands into already-open
# shells -- that is SHARE_HISTORY, left off because it makes autosuggestions
# jumpy (history shifts under you mid-keystroke) and reorders Up-arrow
# unexpectedly. Uncomment if you want live sharing between open windows:
# setopt SHARE_HISTORY
#
# Also available if suggestions feel cluttered by repeats -- it drops older
# duplicates instead of only consecutive ones:
# setopt HIST_IGNORE_ALL_DUPS

# --- Completion ----------------------------------------------------------
# zsh-newuser-install never ran compinit here, so the modern completion system
# (compsys) was never loaded at all. Tab was bound to `expand-or-complete` --
# the primitive pre-compsys builtin, which does plain glob-based filename
# completion and has NO notion of match specs. That is why `cd docu<TAB>`
# could never find Documents/: case-insensitivity is a compsys feature.
# Check what Tab is actually bound to with:
#     zsh -i -c 'bindkey "^I"'
# It should say `complete-word` (or `expand-or-complete` with compsys loaded,
# which is fine) once compinit has run.
autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"

# matcher-list is tried left to right; zsh stops at the first spec that yields
# matches, so these are ordered cheapest/least-surprising first:
#   1. m:{a-zA-Z}={A-Za-z}  case-insensitive both ways -- `docu` -> Documents/
#   2. r:|[._-]=* r:|=*     match on word boundaries -- `f.b` -> foo.bar
#   3. l:|=* r:|=*          substring anywhere -- `chine` -> machine
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# When a prefix is ambiguous, show an interactive menu instead of just beeping.
# Arrow keys (or repeated Tab) cycle through candidates.
zstyle ':completion:*' menu select

# Color the menu like `ls`. Guarded because LS_COLORS is NOT set on this box --
# only zshrc_mac exports it (via vivid). Setting list-colors to an empty value
# is worse than leaving it alone, so this no-ops until LS_COLORS exists.
[[ -n "$LS_COLORS" ]] && zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# alias ls='gls --color=auto --group-directories-first'
eval "$(starship init zsh)"

# --- Omarchy aliases + functions ----------------------------------------
# Not inherited from bash (see the note at the top). Both files are written in
# bash syntax but source cleanly under zsh -- verified: 20 aliases and ~150
# functions load with no errors. Sourced BEFORE alias.sh so that personal
# aliases win on any collision, matching the order ~/.bashrc uses.
[[ -r "$OMARCHY_PATH/default/bash/aliases" ]]   && source "$OMARCHY_PATH/default/bash/aliases"
[[ -r "$OMARCHY_PATH/default/bash/functions" ]] && source "$OMARCHY_PATH/default/bash/functions"

source ~/dotfiles/alias.sh

# Envoy work functions (select_env, startBackEnd, ...). Must come AFTER
# alias.sh, whose `se` alias calls select_env. Functions do not survive the
# bash `exec zsh` handoff, so zsh has to load these itself.
source ~/dotfiles/envoy_scripts.sh

source <(fzf --zsh)

# Mirrors the Mac box. NOTE: ctrl-a never reaches fzf inside tmux, because C-a
# is the tmux prefix and tmux swallows it first. Harmless, and it still works
# in a bare Ghostty window.
export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border --bind "ctrl-a:select-all,ctrl-d:deselect-all"'

# fd instead of find: it honours .gitignore and skips .git, which is what makes
# C-t usable inside envoy-web rather than drowning in node_modules.
if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi

# Preview pane for C-t, matching the `preview` alias in alias.sh.
if command -v bat >/dev/null 2>&1; then
    export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :200 {}' --preview-window=right:60%:wrap"
fi

# History entries can be long; let C-r wrap the highlighted one instead of
# truncating it, and keep the list newest-first.
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:hidden:wrap --bind '?:toggle-preview'"

source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
