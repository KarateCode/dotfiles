# cmd-v → F4
keybind = "cmd+v=text:\x1bOS"
keybind = cmd+shift+v=paste_from_clipboard

# --- tmux window (tab) navigation: Cmd+Alt+Left/Right ---------------------
# keyd turns the physical Cmd key into Control (leftmeta = layer(cmd), and the
# cmd layer is [cmd:C]), so pressing Cmd+Alt+Left actually arrives here as
# ctrl+alt+arrow_left. Ghostty binds that BY DEFAULT to goto_split:left, which
# swallowed it before tmux ever saw it. Splits are tmux's job here.
#
# Unbinding is all that is needed -- unlike Ctrl+Shift+<letter>, arrow keys
# carry their modifiers natively in the escape sequence (CSI 1;7D for
# ctrl+alt+left), so tmux can match `C-M-Left` directly with no user-keys
# indirection. Paired with tmux_omarchy.conf `bind -n C-M-Left/-Right`.
#
# NB these are the ctrl+alt+* pair. The super+alt+* pair just above
# (cmd+alt+left/right -> \x1bOQ / \x1bOR) is a DIFFERENT physical key: keyd
# maps the physical Ctrl key to Super, so those fire from Ctrl+Alt+Arrow.
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind

# unset, so that I can use it as duplicate line in emacs
keybind = cmd+d=unbind
# unset, so that I can use it to grow pane size in tmux
keybind = ctrl+8=unbind
# --- tmux pane keys ------------------------------------------------------
# A terminal cannot encode Shift on a control character (C-l is 0x0c, no bit
# left for shift), so tmux cannot distinguish C-S-l from C-l and plain
# `bind -n C-S-l` bindings never fire. tmux does negotiate the `extkeys`
# feature with Ghostty, but Ghostty still replies with legacy encodings, so
# the protocol route does not work. Send explicit private sequences instead
# and match them in tmux with `user-keys` -- same trick as the cmd+ keys.
#
# Layout: j/l = left/right (Moonlander i/j/k/l arrow layer), y/, = up/down,
# h = "home" / top of scrollback, i/k = page up/down.
#
# Unbinds come first, because these are all Ghostty DEFAULTS:
#   ctrl+shift+j -> write_screen_file:paste,plain
#   ctrl+shift+o -> new_split:right
#   ctrl+shift+,  -> reload_config      (the "Reload the configuration" flash)
#   ctrl+shift+i -> inspector:toggle
# ctrl+, further down is a DIFFERENT key and stays mapped for Emacs.
# ctrl+shift+l, ctrl+shift+y, ctrl+shift+h and ctrl+shift+k were already free.
#
# ctrl+shift+u is deliberately NOT used: GTK's gtk-im-context-simple claims
# it for Unicode entry (the "U+" prompt) above Ghostty's keybinding layer, so
# Ghostty never sees it. Routing GTK through fcitx5 would free it but caused
# problems, so j took its place.
#
# Paired with tmux_omarchy.conf `set -s user-keys[0..6]` + `bind -n User0..6`.
# Keep both sides in sync; a mismatch just makes the key do nothing.
keybind = ctrl+shift+j=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+,=unbind
keybind = ctrl+shift+i=unbind
keybind = ctrl+shift+j=text:\x1b[124;9z
keybind = ctrl+shift+l=text:\x1b[125;9z
keybind = ctrl+shift+y=text:\x1b[126;9z
keybind = ctrl+shift+,=text:\x1b[127;9z
keybind = ctrl+shift+h=text:\x1b[128;9z
keybind = ctrl+shift+i=text:\x1b[129;9z
keybind = ctrl+shift+k=text:\x1b[130;9z

# --- Cmd+Enter -> insert-line in Emacs ------------------------------------
# keyd turns the physical Cmd key into Control, so Cmd+Enter arrives here as
# ctrl+enter -- which Ghostty binds BY DEFAULT to toggle_fullscreen. That was
# the surprise fullscreen; it never reached Emacs.
#
# Deliberately emits the SAME \x1b[111;9z as super+enter further down, so both
# physical keys land on Emacs' [cmd-enter] -> insert-line. On macOS that same
# config line fires from the real Cmd key via super+enter.
# Decoded by init.el: (define-key input-decode-map "\e[111;9z" [cmd-enter])
keybind = ctrl+enter=unbind
keybind = ctrl+enter=text:\x1b[111;9z

# Cmd+Shift+F -> Emacs "find in project" (my/project-grep-empty, a
# consult-ripgrep rooted at the projectile project). Ghostty's default on
# ctrl+shift+f is start_search, which swallowed it.
#
# Trade-off: this gives up Ghostty's own in-terminal search, which had no
# other binding. Scrollback search is still available via tmux copy-mode
# (prefix C-r, tmux_omarchy.conf), so nothing is really lost here.
# Decoded by init.el: "\e[113;9z" -> [cmd-shift-f]
keybind = ctrl+shift+f=unbind
keybind = ctrl+shift+f=text:\x1b[113;9z

# Same story for Cmd+Shift+Enter -> Emacs insert-line-above. Ghostty's default
# on ctrl+shift+enter is toggle_split_zoom, which swallowed it.
# Decoded by init.el: "\e[111;10z" -> [cmd-shift-enter]
keybind = ctrl+shift+enter=unbind
keybind = ctrl+shift+enter=text:\x1b[111;10z

keybind = PageUp=text:\x1b[5~
keybind = PageDown=text:\x1b[6~

keybind = cmd+c=text:\x1b[118;9z
keybind = "cmd+s=unbind"
keybind = cmd+s=text:\x1b[119;9z

keybind = cmd+x=text:\x1b[120;9z

keybind = shift+PageUp=scroll_page_up
keybind = shift+PageDown=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom
# Plain keys → send escapes to tmux
keybind = home=text:\x1b[H
keybind = end=text:\x1b[F

# Prevent the default Cmd+J behavior if any
keybind = "cmd+j=unbind"
keybind = cmd+j=text:\x1b[114;9z

# Prevent Cmd+Z from being handled by Ghostty itself
keybind = "cmd+z=unbind"

# Send ESC+z when Cmd+Z is pressed
# The only way to get an actual command/super is to use GUI Emacs
# We can't map to Esc as a prefix, because that is Alt's default mapping
# So instead, we're going to map to a uniq charater string
keybind = cmd+z=text:\x1b[108;9z
keybind = "cmd+shift+z=unbind"
keybind = cmd+shift+z=text:\x1b[109;9z
keybind = cmd+d=text:\x1b[110;9z
keybind = "cmd+enter=unbind"
keybind = cmd+enter=text:\x1b[111;9z
keybind = cmd+shift+enter=text:\x1b[111;10z
keybind = cmd+shift+f=text:\x1b[113;9z
keybind = cmd+e=text:\x1b[122;9z
keybind = cmd+l=text:\x1b[123;9z

keybind = "cmd+alt+up=unbind"
keybind = cmd+alt+up=text:\x1b[115;9z
keybind = "cmd+alt+down=unbind"
keybind = cmd+alt+down=text:\x1b[116;9z

keybind = ctrl+shift+backspace=text:\x1b[117;9z

