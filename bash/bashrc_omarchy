# bashrc for the Omarchy (Linux) box.
#
# Symlinked into place with:
#   ln -s ~/dotfiles/bash/bashrc_omarchy ~/.bashrc
#
# bash is the login shell deliberately (do NOT `chsh -s /usr/bin/zsh`):
# Omarchy's env-bootstrap and rc only run for bash. This file does that setup
# and then hands off to zsh at the very bottom -- see ~/dotfiles/zsh/zshrc_omarchy.
#
# ~/.bash_profile is stock Arch boilerplate (`[[ -f ~/.bashrc ]] && . ~/.bashrc`)
# and is left untracked in $HOME, since it is identical on every Arch install.
#
# Shell-agnostic aliases live in ~/dotfiles/alias.sh, kept at the dotfiles root
# rather than in bash/ because zshrc_omarchy sources the same file.
#
# Safe to symlink: nothing in Omarchy writes to ~/.bashrc -- the only mentions
# in /usr/share/omarchy are comments referring to /etc/skel/.bashrc.

# Omarchy environment (OMARCHY_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$HOME/go/bin:$PATH"
fi

# --- Editor ---------------------------------------------------------------
# Terminal Emacs, not a detached GUI frame.
#
# Omarchy ships EDITOR="omarchy-launch-editor --inline". That launcher reads
# ~/.local/state/omarchy/defaults/editor (currently "emacs") and then decides:
#
#     case "${editor##*/}" in
#     nvim | vim | nano | micro | hx | helix | fresh)   # TUI whitelist
#       ... exec "$editor" "$@"                         # runs in this terminal
#     *)
#       exec setsid uwsm-app -- "$editor" "$@"          # GUI, detached
#
# "emacs" is not on that whitelist, so it always falls to the GUI branch. That
# is the whole bug -- and `omarchy-default-editor` cannot fix it, because it
# only accepts a fixed list of editor NAMES and has no way to express a flag
# like -nw.
#
# Setting EDITOR here is the sanctioned escape hatch rather than a hack:
# omarchy's default/bash/envs is written as
#     export EDITOR="${EDITOR:-omarchy-launch-editor --inline}"
#     export SUDO_EDITOR="$EDITOR"
# so a pre-set EDITOR is deliberately left alone, and SUDO_EDITOR follows it
# for free. This MUST stay above the rc source below for that :- to see it.
#
# One assignment covers both shells: exported variables survive the `exec zsh`
# handoff at the bottom of this file, which is exactly why the lost-functions
# problem documented in zshrc_omarchy does NOT apply to env vars.
#
# Leaves ~/.local/state/omarchy/defaults/editor alone at "emacs", so anything
# that asks omarchy which editor you use still gets the right answer.
#
# The wrapper goes through emacsclient against the systemd-managed daemon:
# ~1.5s of init.el startup per invocation becomes ~0.2s. It is a script rather
# than an inline "emacsclient -nw -a ''" so that $EDITOR stays a single
# space-free token -- omarchy copies it into SUDO_EDITOR, and sudo splits that
# on whitespace without honouring quotes. See the script for the full reasoning.
export EDITOR="$HOME/dotfiles/scripts/emacs-editor.sh"

# All the default Omarchy aliases and functions
# (don't mess with these directly, just overwrite them here!)
source "$OMARCHY_PATH/default/bash/rc"

# Add your own exports, aliases, and functions here.
#
# Make an alias for invoking commands you use constantly
# alias p='python'
source ~/dotfiles/alias.sh
source ~/dotfiles/.sensitive.sh

select_env() {
    local arg="$1"
    eval "$("$HOME/code/tools-and-infrastructure/scripts/developer/select_env_menu.sh" "$arg")"
}

# Node is managed by mise (Omarchy puts ~/.local/share/mise/shims on PATH via
# /etc/security/pam_env.conf). Per-project versions come from .nvmrc /
# .node-version via the idiomatic_version_file_enable_tools setting in
# ~/.config/mise/config.toml. fnm was removed -- it only applied to interactive
# shells, so GUI-launched and non-interactive processes silently got a
# different node than your terminal did.

# LazyVPN
export PATH="/home/michael/.local/bin:$PATH"

# source ~/code/ble.sh/out/ble.sh

# --- Hand off to zsh -----------------------------------------------------
# Deliberately NOT `chsh -s /usr/bin/zsh`: Omarchy expects bash as the login
# shell, because everything above (env-bootstrap -> OMARCHY_PATH/PATH, then
# $OMARCHY_PATH/default/bash/rc) only runs for bash. Starting bash, letting it
# do that setup, then replacing it keeps Omarchy intact and still lands in zsh.
#
# `exec` is the important part. A bare `zsh` left bash sitting underneath, so
# exiting zsh dropped you at a bash prompt and closing a terminal took two
# exits. exec replaces the process instead.
#
# The guard prevents a second handoff if something later starts `bash -i`
# from inside zsh -- without it that would stack another zsh on top.
#
# The guard asks "is my PARENT zsh?" rather than reading an exported marker
# variable. An exported marker was the previous approach and it broke tmux:
# `export OMARCHY_ZSH_HANDOFF=1` leaked into the environment of every
# descendant, including the tmux SERVER (started from zsh). tmux then spawned
# each pane as $SHELL (= bash), that bash saw the inherited marker, skipped the
# handoff, and every pane sat in bash -- no zsh-autosuggestions, no zsh
# history, none of ~/.zshrc. Vanilla Ghostty was fine because it is launched by
# the compositor, which never saw the marker.
#
# Parent-process inspection has no such leak, because it describes the actual
# relationship instead of a sticky flag:
#   Ghostty  -> parent is ghostty    -> hand off   (correct)
#   tmux pane-> parent is tmux server-> hand off   (correct; was broken)
#   `bash` typed at a zsh prompt -> parent is zsh -> stay in bash (correct)
# Cost is one `ps` fork per interactive bash, once per terminal.
#
# Note this line is below the `[[ $- != *i* ]] && return` near the top, so
# non-interactive bash (scp, ssh command, scripts) is unaffected.
if command -v zsh >/dev/null 2>&1 &&
   [[ $(ps -o comm= -p "$PPID" 2>/dev/null) != zsh ]]; then
    exec zsh
fi
